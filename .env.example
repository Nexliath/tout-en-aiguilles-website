# ════════════════════════════════════════
# Tout en Aiguilles — Configuration
# Copiez ce fichier en .env et remplissez
# ════════════════════════════════════════

# Serveur
PORT=3000
BASE_URL=http://localhost:3000

# JWT (changez cette clé en production !)
JWT_SECRET=votre_cle_secrete_tres_longue_et_aleatoire

# Stripe (obtenez vos clés sur https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Origine autorisée (CORS)
ALLOWED_ORIGIN=http://localhost:3000

# Email (SMTP) — pour la confirmation de compte
# Brevo (ex-Sendinblue) recommandé : smtp-relay.brevo.com port 587
# Gmail : smtp.gmail.com port 587 (nécessite un "mot de passe d'application")
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@exemple.fr
SMTP_PASS=votre_cle_smtp
SMTP_FROM=Tout en Aiguilles <noreply@toutenaiguilles.fr>

# Brevo API (envoi d'emails transactionnels + newsletter via l'API HTTP,
# indépendant du SMTP ci-dessus) — sans cette clé, les emails (confirmation
# newsletter, relance panier abandonné, alerte réassort...) sont simulés en
# mode démo (juste loggés en console, rien n'est réellement envoyé).
BREVO_API_KEY=votre_cle_api_brevo

# Chemin d'accès au backoffice admin — DOIT être défini en production avec
# une valeur secrète et imprévisible. Sans ça, "atelier" (valeur par défaut,
# visible dans le code source donc publique) est utilisé.
ADMIN_PATH=atelier

# Email de réception des messages du formulaire de contact et des
# notifications boutique (nouvelle commande, etc.). Par défaut :
# tout.en.aiguilles@gmail.com si non défini.
CONTACT_EMAIL=votre_email@exemple.fr

# PayPal (obtenez vos identifiants sur https://developer.paypal.com)
# PAYPAL_MODE=sandbox pour les tests, =live en production.
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal
PAYPAL_MODE=sandbox

# Secret partagé pour authentifier les appels aux tâches planifiées
# (rappels d'avis, relances panier abandonné...) déclenchées par un cron
# externe (ex. Railway Cron, cron-job.org) sur /api/orders/review-reminders.
CRON_SECRET=une_chaine_secrete_aleatoire

# Seeding — à activer UNE SEULE FOIS (ou en local) puis remettre à false.
# RUN_SEED : jeu de données initial (produits, catégories démo...).
# RUN_FAKE_REVIEWS_SEED : avis clients fictifs pour peupler une boutique vide.
RUN_SEED=false
RUN_FAKE_REVIEWS_SEED=false
